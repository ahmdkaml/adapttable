# Fast per-commit guard: formatting only, so commits stay instant. The full
# quality gate (pnpm check) runs on pre-push — nothing unchecked leaves the
# machine, and CI guards the PR either way.
# Hooks inherit the committing tool's PATH; GUI clients and non-interactive
# shells may not carry pnpm there — corepack ships with Node and resolves
# the pinned pnpm either way.
if command -v pnpm >/dev/null 2>&1; then
  pnpm format:check
else
  corepack pnpm format:check
fi
