# The full quality gate runs before anything leaves the machine. Turbo
# caches keep re-runs fast when nothing changed since the last green run.
# Hooks inherit the pushing tool's PATH; GUI clients and non-interactive
# shells may not carry pnpm there — corepack ships with Node and resolves
# the pinned pnpm either way.
if command -v pnpm >/dev/null 2>&1; then
  pnpm check
else
  corepack pnpm check
fi
