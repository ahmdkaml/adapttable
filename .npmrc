auto-install-peers=true
strict-peer-dependencies=false
save-workspace-protocol=rolling
# Starters keep ^2.0.0 so StackBlitz installs from npm. Inside this
# monorepo they must typecheck against the workspace packages — otherwise
# a new classNames key fails CI on the published 2.0.0 .d.ts.
link-workspace-packages=true
prefer-workspace-packages=true
provenance=true
