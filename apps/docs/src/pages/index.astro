---
// Static landing at the site root, in the SHOWCASE's own design system —
// the same oklch tokens, type, badge, install pill and chip language as
// /demo, so the funnel reads as one product. Pre-rendered text + JSON-LD
// carry the SEO; the live demo stays at /demo, the guide at
// /getting-started/.
const SITE = "https://orwa-mahmoud.github.io/adapttable";
const TITLE =
  "AdaptTable — Headless React Data Table for Mantine, MUI, Chakra, Ant Design & Tailwind";
const DESCRIPTION =
  "One headless React data-table engine with batteries-included adapters: declarative columns and filters, URL-synced state, server or client data, 50,000-row virtualization, column management, saved views, i18n and RTL — rendered natively by your design system.";

const KITS = [
  { label: "Mantine", c: "#4c6ef5" },
  { label: "MUI", c: "#007fff" },
  { label: "Chakra UI", c: "#319795" },
  { label: "Ant Design", c: "#1677ff" },
  { label: "shadcn / Tailwind", c: "#18181b" },
];

const FEATURES = [
  {
    viz: "filter",
    hue: "274",
    title: "Declarative columns & filters",
    body: "`{ key: \"team\", filter: \"multiSelect\" }` — one definition drives the widget, the URL params, the chips and the row predicate. Operator-first number and date filters: Equal, At least, At most, Between.",
  },
  {
    viz: "tiers",
    hue: "210",
    title: "Three data tiers",
    body: "Hand the table an array and it filters, sorts and pages in memory. Or own the fetch: one consolidated query event with an abort signal. Or bring a full custom TableSource.",
  },
  {
    viz: "url",
    hue: "152",
    title: "URL-synced everything",
    body: "Search, sort, filters, pagination, column layout and saved views live in shareable URLs — namespaced per table, SSR-safe, with a one-prop opt-out (urlSync={false}).",
  },
  {
    viz: "rows",
    hue: "60",
    title: "50,000 rows, no flinching",
    body: "Opt-in virtualization windows the DOM against the page or any max-height scroll box. The live demo scrolls fifty thousand rows with a handful of DOM nodes.",
  },
  {
    viz: "i18n",
    hue: "25",
    title: "i18n & RTL, for real",
    body: "Label presets for ten locales. Columns map per-locale data paths, so cells, sorting and filtering follow the language. Pinning and layout are logical — Arabic and Hebrew just work.",
  },
  {
    viz: "columns",
    hue: "330",
    title: "Column management & views",
    body: "Show, hide, reorder, pin and resize — the row-actions column included. Capture any state as a named saved view and restore it later, per table.",
  },
];

const ROWS = [
  { i: "AL", name: "Ada Lovelace", role: "Engineer", s: "Planned", tone: "blue", date: "Mar 8, 2026", money: "$25,300", load: 56 },
  { i: "AT", name: "Alan Turing", role: "Founder", s: "Blocked", tone: "red", date: "May 15, 2026", money: "$32,600", load: 67 },
  { i: "GH", name: "Grace Hopper", role: "Designer", s: "Archived", tone: "gray", date: "Jul 22, 2026", money: "$39,900", load: 78 },
  { i: "KJ", name: "Katherine Johnson", role: "Researcher", s: "Active", tone: "green", date: "Sep 3, 2026", money: "$47,200", load: 89 },
];

const JSON_LD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "AdaptTable",
  description: DESCRIPTION,
  url: `${SITE}/`,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  license: "https://opensource.org/license/mit",
  programmingLanguage: "TypeScript",
  codeRepository: "https://github.com/orwa-mahmoud/adapttable",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href={`${SITE}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${SITE}/sitemap-index.xml`} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AdaptTable" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <script type="application/ld+json" set:html={JSON_LD} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="shell nav__inner">
        <a class="brand" href={`${SITE}/`}>
          <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#6c5ce7"></rect>
            <rect x="7" y="8" width="18" height="3.2" rx="1.2" fill="#fff"
            ></rect>
            <rect
              x="7"
              y="14.4"
              width="18"
              height="3.2"
              rx="1.2"
              fill="#fff"
              opacity="0.85"></rect>
            <rect
              x="7"
              y="20.8"
              width="18"
              height="3.2"
              rx="1.2"
              fill="#fff"
              opacity="0.7"></rect>
          </svg>
          <span>Adapt<b>Table</b></span>
        </a>
        <nav aria-label="Primary">
          <a href={`${SITE}/demo/`}>Live demo</a>
          <a href={`${SITE}/getting-started/`}>Docs</a>
          <a href={`${SITE}/api/`}>API</a>
          <a href={`${SITE}/comparison/`}>Compare</a>
          <a class="nav__cta" href="https://github.com/orwa-mahmoud/adapttable"
            >GitHub</a
          >
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero shell">
        <p class="badge">
          <span class="badge__bolt" aria-hidden="true">⚡</span>
          Headless engine · batteries-included adapters · MIT
        </p>
        <h1 class="reveal">
          The headless React <span class="nowrap">data table</span><br /><em
            >for any UI kit.</em
          >
        </h1>
        <p class="hero__sub reveal">
          TanStack-style headless freedom — but batteries-included for
          <i>your</i> kit. One declarative API renders natively in Mantine,
          MUI, Chakra UI, Ant Design, or your own Tailwind classes. URL-synced
          state, a real filter UX, virtualization, i18n and RTL, out of the
          box.
        </p>
        <div class="hero__cta reveal">
          <a class="btn-primary" href={`${SITE}/demo/`}>Try the live demo</a>
          <code class="install"
            ><span aria-hidden="true">$</span> npx @adapttable/cli init</code
          >
          <a class="hero__link" href={`${SITE}/getting-started/`}
            >Get started →</a
          >
        </div>
        <p class="hero__kits reveal">
          <span>Renders natively in</span>
          {
            KITS.map((kit) => (
              <i class="chip">
                <b style={`background:${kit.c}`} />
                {kit.label}
              </i>
            ))
          }
        </p>
      </section>

      <!-- The product, not a metaphor: a static table mock in pure CSS,
           skinned with the same tokens the live demo uses. -->
      <figure class="mock shell reveal" aria-hidden="true">
        <div class="mock__toolbar">
          <span class="mock__search">⌕ Search people…</span>
          <span class="mock__spacer"></span>
          <span class="mock__btn">≔ Filters <b>2</b></span>
          <span class="mock__btn">Columns</span>
        </div>
        <div class="mock__chips">
          <span>Team: Core ✕</span><span>Budget ≥ 25,000 ✕</span>
        </div>
        <div class="mock__table">
          <div class="mock__row mock__row--head">
            <span>Person ↕</span><span>Status</span><span>Timeline ↕</span>
            <span class="num">Budget ↕</span><span>Load</span>
          </div>
          {
            ROWS.map((r) => (
              <div class="mock__row">
                <span class="cell-person">
                  <i class={`avatar avatar--${r.tone}`}>{r.i}</i>
                  <span>
                    <b>{r.name}</b>
                    <small>{r.role}</small>
                  </span>
                </span>
                <span>
                  <i class={`pill pill--${r.tone}`}>{r.s}</i>
                </span>
                <span class="cell-date">
                  <b>{r.date}</b>
                </span>
                <span class="num">
                  <b>{r.money}</b>
                </span>
                <span class="cell-load">
                  <i class="bar">
                    <i style={`width:${r.load}%`} />
                  </i>
                  <small>{r.load}%</small>
                </span>
              </div>
            ))
          }
        </div>
        <div class="mock__footer">
          <span>Rows per page 8 · Showing 1–4 of 12</span>
          <span class="mock__pager">‹ <b class="pg pg--on">1</b><b class="pg">2</b><b class="pg">3</b> ›</span>
        </div>
        <figcaption class="mock__url">
          ?live.f_team=Core&amp;live.f_budgetMin=25000 · every bit of state in
          a shareable URL
        </figcaption>
      </figure>

      <section class="sec shell" aria-labelledby="features-h">
        <p class="kicker">Why AdaptTable</p>
        <h2 id="features-h">Everything a data table owes you</h2>
        <div class="grid">
          {
            FEATURES.map((f, n) => (
              <article class="card" style={`--hue:${f.hue};--n:${n}`}>
                <div class="viz" aria-hidden="true">
                  {f.viz === "filter" && (
                    <>
                      <span class="viz-chip">Team: Core ✕</span>
                      <span class="viz-chip">Budget ≥ 25k ✕</span>
                      <span class="viz-chip viz-chip--ghost">+ Add filter</span>
                    </>
                  )}
                  {f.viz === "tiers" && (
                    <span class="viz-stack">
                      <i>data={"{rows}"}</i>
                      <i>onQueryChange(q)</i>
                      <i>TableSource</i>
                    </span>
                  )}
                  {f.viz === "url" && (
                    <span class="viz-url">
                      <i class="viz-dot" />
                      ?q=ada&amp;f_team=Core&amp;sort=name
                    </span>
                  )}
                  {f.viz === "rows" && (
                    <span class="viz-rows">
                      <i />
                      <i />
                      <i class="on" />
                      <i class="on" />
                      <i class="on" />
                      <i />
                      <b>8 of 50,000 in the DOM</b>
                    </span>
                  )}
                  {f.viz === "i18n" && (
                    <span class="viz-i18n">
                      <i dir="ltr">Name ↑</i>
                      <i dir="rtl">الاسم ↑</i>
                    </span>
                  )}
                  {f.viz === "columns" && (
                    <span class="viz-cols">
                      <i>Person</i>
                      <i class="pinned">Status 📌</i>
                      <i>Budget</i>
                      <i class="off">Email</i>
                    </span>
                  )}
                </div>
                <h3>{f.title}</h3>
                <p set:html={f.body.replace(/`([^`]+)`/g, "<code>$1</code>")} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="sec shell snippet" aria-labelledby="snippet-h">
        <div class="snippet__copy">
          <h2 id="snippet-h">Five lines to your first table</h2>
          <p>
            Bare keys become columns with humanized headers. A
            <code>filter</code> shorthand becomes the kit-native widget, the
            URL params, the chips and the predicate — nothing else to wire.
          </p>
          <p>
            Read the <a href={`${SITE}/getting-started/`}>Getting started guide</a>
            or the <a href={`${SITE}/comparison/`}
              >comparison with TanStack Table</a
            >.
          </p>
        </div>
        <pre><code>{`import { DataTable } from "@adapttable/mantine";
// or mui, chakra, antd, unstyled

<DataTable
  data={people}
  columns={[
    { key: "name" },
    { key: "team", filter: "multiSelect" },
    { key: "hiredAt", filter: "dateRange" },
  ]}
/>`}</code></pre>
      </section>
    </main>

    <footer class="foot">
      <div class="shell foot__inner">
        <span>MIT · TypeScript · React 18+</span>
        <nav aria-label="Footer">
          <a href={`${SITE}/getting-started/`}>Getting started</a>
          <a href={`${SITE}/customization/`}>Customization</a>
          <a href={`${SITE}/url-state/`}>URL state</a>
          <a href={`${SITE}/faq/`}>FAQ</a>
          <a href="https://www.npmjs.com/org/adapttable">npm</a>
          <a href="https://github.com/orwa-mahmoud/adapttable">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  /* The showcase's exact token set (light theme), so /demo and the
     landing read as one product. */
  :root {
    --page-bg: oklch(0.985 0.004 264);
    --page-surface: oklch(1 0 0);
    --page-surface-2: oklch(0.975 0.004 264);
    --page-border: oklch(0.91 0.005 264);
    --page-border-soft: oklch(0.945 0.004 264);
    --ink: oklch(0.22 0.014 264);
    --ink-2: oklch(0.46 0.012 264);
    --ink-3: oklch(0.62 0.01 264);
    --brand: oklch(0.55 0.19 274);
    --brand-soft: oklch(0.95 0.04 274);
    --shadow-card:
      0 1px 2px oklch(0.2 0.02 264 / 0.04),
      0 8px 28px oklch(0.2 0.02 264 / 0.06);
    --green: oklch(0.62 0.16 152);
    --red: oklch(0.6 0.19 25);
    --blue: oklch(0.58 0.17 255);
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: "Schibsted Grotesk", system-ui, sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
  }
  .shell {
    max-width: 1140px;
    margin: 0 auto;
    padding-inline: clamp(18px, 4vw, 28px);
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 16px;
    top: 12px;
    background: var(--brand);
    color: #fff;
    padding: 8px 14px;
    border-radius: 8px;
    z-index: 10;
  }

  .nav {
    border-bottom: 1px solid var(--page-border-soft);
    background: color-mix(in oklch, var(--page-bg) 86%, white);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 19px;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .brand b {
    font-weight: 800;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 26px);
    flex-wrap: wrap;
  }
  .nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 550;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav__cta {
    height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 15px;
    border-radius: 9px;
    background: var(--ink);
    color: var(--page-bg) !important;
    font-weight: 600;
  }

  /* ── Hero (the showcase's composition) ─────────────────────────── */
  .hero {
    position: relative;
    padding-top: clamp(48px, 8vw, 96px);
    text-align: center;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -64px 0 auto;
    height: 420px;
    background: radial-gradient(
      60% 60% at 50% 0%,
      color-mix(in oklch, var(--brand) 11%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  .badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 26px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 550;
    color: var(--brand);
    border: 1px solid color-mix(in oklch, var(--brand) 22%, transparent);
    /* Shimmer: a light band sweeps the pill on each broadcast beat. */
    background:
      linear-gradient(
          115deg,
          transparent 30%,
          color-mix(in oklch, white 65%, transparent) 46%,
          transparent 62%
        )
        no-repeat,
      var(--brand-soft);
    background-size: 250% 100%, auto;
    /* Entrance rise once, then the shimmer beat forever. */
    animation:
      rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      shimmer 5s ease-in-out 0.8s infinite;
  }
  /* Broadcast ring: a radio wave leaves the pill on the same beat. */
  .badge::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: 0 0 0 0 color-mix(in oklch, var(--brand) 38%, transparent);
    animation: wave 5s ease-out infinite;
  }
  .badge__bolt {
    animation: bolt 5s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 55%, 100% { background-position: 215% 0, 0 0; }
    25% { background-position: -45% 0, 0 0; }
  }
  @keyframes wave {
    0%, 18% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--brand) 38%, transparent); }
    52% { box-shadow: 0 0 0 14px color-mix(in oklch, var(--brand) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--brand) 0%, transparent); }
  }
  @keyframes bolt {
    0%, 14%, 30%, 100% { transform: none; filter: none; }
    20% { transform: scale(1.25) rotate(-6deg); filter: drop-shadow(0 0 6px color-mix(in oklch, var(--brand) 60%, transparent)); }
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6.6vw, 76px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  h1 em {
    font-style: normal;
    color: var(--brand);
  }
  .nowrap {
    white-space: nowrap;
  }
  .hero__sub {
    margin: 24px auto 0;
    max-width: 640px;
    font-size: clamp(16px, 1.7vw, 19px);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .hero__sub i {
    color: var(--ink);
  }
  .hero__cta {
    margin-top: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 22px;
    border-radius: 11px;
    background: var(--ink);
    color: var(--page-bg);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 16px;
    background: var(--page-surface);
    border: 1px solid var(--page-border);
    border-radius: 11px;
    box-shadow: var(--shadow-card);
    font-family: var(--mono);
    font-size: 14px;
  }
  .install span {
    color: var(--brand);
    font-weight: 700;
  }
  .hero__link {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
  }
  .hero__link:hover {
    color: var(--brand);
  }
  .hero__kits {
    margin: 48px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero__kits span {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-inline-end: 4px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--page-border);
    background: var(--page-surface);
    font-size: 13.5px;
    font-weight: 600;
    font-style: normal;
  }
  .chip b {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  /* ── The product mock, in the demo's skin ──────────────────────── */
  .mock {
    margin-top: 44px;
    margin-bottom: 8px;
    border: 1px solid var(--page-border);
    border-radius: 16px;
    background: var(--page-surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    font-size: 13.5px;
    padding-inline: 0;
  }
  .mock__toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--page-border-soft);
  }
  .mock__search {
    flex: 0 1 290px;
    border: 1px solid var(--page-border);
    border-radius: 9px;
    padding: 9px 13px;
    color: var(--ink-3);
    background: var(--page-surface);
  }
  .mock__spacer {
    flex: 1;
  }
  .mock__btn {
    border: 1px solid var(--page-border);
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
    background: var(--page-surface);
  }
  .mock__btn b {
    display: inline-grid;
    place-items: center;
    width: 19px;
    height: 19px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-size: 11px;
    margin-inline-start: 4px;
  }
  .mock__chips {
    display: flex;
    gap: 8px;
    padding: 12px 18px 2px;
    flex-wrap: wrap;
  }
  .mock__chips span {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--brand);
    background: var(--brand-soft);
