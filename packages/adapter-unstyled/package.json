{
  "name": "@adapttable/unstyled",
  "version": "0.0.0",
  "description": "Headless, unstyled AdaptTable adapter — semantic HTML with class + data-attribute hooks for Tailwind, shadcn/ui, or your own CSS.",
  "keywords": [
    "react",
    "data-table",
    "table",
    "headless",
    "unstyled",
    "tailwind",
    "shadcn",
    "url-state",
    "rtl",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://github.com/orwamahmoud/adapttable/tree/main/packages/adapter-unstyled#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwamahmoud/adapttable.git",
    "directory": "packages/adapter-unstyled"
  },
  "bugs": "https://github.com/orwamahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@adapttable/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
