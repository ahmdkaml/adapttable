{
  "name": "@adapttable/i18n",
  "version": "0.0.0",
  "description": "Locale presets (English, Arabic) and RTL direction helpers for AdaptTable — first-class right-to-left and Arabic support.",
  "keywords": [
    "react",
    "data-table",
    "i18n",
    "localization",
    "rtl",
    "arabic",
    "direction",
    "adapttable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://github.com/orwamahmoud/adapttable/tree/main/packages/i18n#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/orwamahmoud/adapttable.git",
    "directory": "packages/i18n"
  },
  "bugs": "https://github.com/orwamahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@adapttable/core": "workspace:*"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
